generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserPosition {
  TRAFFIC_AGENT
  OPERATIONS_AGENT
}

enum CarType {
  CAR
  MOTORCYCLE
  PICKUP
}

enum CarStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum DayReportStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FuelStatus {
  YES
  NOT
}

enum InspectionType {
  START
  END
}

enum InspectionCondition {
  GOOD
  ATTENTION
  DAMAGED
  NOT_CHECKED
}

model User {
  register     String       @id @db.VarChar(5) 
  name         String       @db.VarChar(150)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  photo        String?      @db.VarChar(500)
  email        String?      @unique @db.VarChar(255)
  position     UserPosition @default(TRAFFIC_AGENT)
  role         UserRole     @default(USER)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trips Trip[]

  @@map("users")
}


model Item{
  id String @id @default(uuid()) @db.Uuid
  name String
  description String?
  inspectItems InspectionItems[]
  itemsCars CarItems[]
  
  @@map("item")
}

model CarItems{
  id String @id @default(uuid()) @db.Uuid
  carId String @map("car_id")
  ItemId String @map("item_id")
  status InspectionCondition @default(GOOD)

  car Cars @relation(fields: [carId], references: [id])
  item Item @relation(fields: [ItemId], references: [id])

  @@map("cars_item")
}



model InspectionItems{
  id String @id @default(uuid()) @db.Uuid
  idItem String @map("id_item")
  idCars String @map("id_cars")

  items Item @relation(fields: [idItem], references: [id])
  
  @@map("inspection_items")
}


model Cars {
  id        String  @id @default(uuid()) @db.Uuid
  type      CarType @default(CAR)
  marca     String
  model     String
  plate     String  @db.VarChar(7)
  kmCurrent Int     @map("km_current")

  trips Trip[]
  item CarItems[]
  @@map("cars")
}



model Trip {
  id        String  @id @default(uuid()) @db.Uuid
  kmInitial    Int                @map("km_initial")
  kmFinal      Int?               @map("km_final")
  description  String?
  Fuel         FuelStatus   @default(NOT)
  status       TripStatus         @default(IN_PROGRESS)
  carId        String             @map("car_id")
  userRegister String             @map("user_register") @db.VarChar(5)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  car    Cars        @relation(fields: [carId], references: [id])
  user   User        @relation(fields: [userRegister], references: [register])
  photos TripPhoto[]
  @@index([carId])
  @@index([userRegister])
  @@map("trips")
}

model TripPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  path      String   @db.VarChar(500)
  tripId    String   @map("trip_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_photos")
}
